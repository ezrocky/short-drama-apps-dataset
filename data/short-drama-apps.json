{
  "name": "Short Drama Apps Dataset",
  "description": "Store ratings, install counts, in-app prices, aggregated user-review complaint shares and data-based scores for the short drama (vertical micro-drama) apps ranked by Vertical Drama Reviews. Updated weekly, with a monthly snapshot archive.",
  "source": "Source: Vertical Drama Reviews (https://verticaldramareviews.com/data)",
  "url": "https://verticaldramareviews.com/data",
  "license": {
    "name": "Creative Commons Attribution 4.0 International",
    "url": "https://creativecommons.org/licenses/by/4.0/"
  },
  "dateModified": "2026-11-09",
  "fields": [
    {
      "name": "slug",
      "type": "string",
      "description": "Stable identifier of the app at Vertical Drama Reviews.",
      "source": "Vertical Drama Reviews",
      "unit": "text"
    },
    {
      "name": "name",
      "type": "string",
      "description": "App name.",
      "source": "App Store / Google Play listing",
      "unit": "text"
    },
    {
      "name": "developer",
      "type": "string",
      "description": "Developer or publisher.",
      "source": "App Store / Google Play listing",
      "unit": "text"
    },
    {
      "name": "platforms",
      "type": "string[]",
      "description": "Platforms the app is available on. In the CSV, values are separated by \";\".",
      "source": "App Store / Google Play listing",
      "unit": "list"
    },
    {
      "name": "app_store_rating",
      "type": "number",
      "description": "Average user rating on the US App Store, as returned by Apple (not rounded).",
      "source": "App Store (US)",
      "unit": "stars, 1–5"
    },
    {
      "name": "app_store_ratings_count",
      "type": "integer",
      "description": "Number of ratings behind app_store_rating.",
      "source": "App Store (US)",
      "unit": "count"
    },
    {
      "name": "google_play_rating",
      "type": "number",
      "description": "Average user rating on Google Play (US), as returned by Google (not rounded).",
      "source": "Google Play (US)",
      "unit": "stars, 1–5"
    },
    {
      "name": "google_play_ratings_count",
      "type": "integer",
      "description": "Number of ratings behind google_play_rating.",
      "source": "Google Play (US)",
      "unit": "count"
    },
    {
      "name": "google_play_installs",
      "type": "integer",
      "description": "Lower bound of the install range shown on Google Play (for example, \"100,000,000+\" becomes 100000000).",
      "source": "Google Play (US)",
      "unit": "installs"
    },
    {
      "name": "price_from_usd",
      "type": "number",
      "description": "The \"from\" price shown on our site: the cheapest item in the App Store's top in-app purchases list, or the low end of the Google Play price range when the App Store lists none. Apple shows only the most popular in-app purchases on an app's page (up to 10), not the full price list. Empty if neither store lists prices.",
      "source": "App Store / Google Play (US)",
      "unit": "USD"
    },
    {
      "name": "iap_price_min_usd",
      "type": "number",
      "description": "Lowest price in the App Store's top in-app purchases list. Apple shows only the most popular in-app purchases on an app's page (up to 10), not the full price list. Cheaper items may exist.",
      "source": "App Store (US), top in-app purchases",
      "unit": "USD"
    },
    {
      "name": "iap_price_max_usd",
      "type": "number",
      "description": "Highest price in the App Store's top in-app purchases list. Apple shows only the most popular in-app purchases on an app's page (up to 10), not the full price list. More expensive items may exist.",
      "source": "App Store (US), top in-app purchases",
      "unit": "USD"
    },
    {
      "name": "subscription_seen_in_app_store_top_iaps",
      "type": "boolean",
      "description": "true if a subscription appears in the App Store's top in-app purchases list. Empty means unknown, not \"no subscription\": Apple shows only the most popular in-app purchases on an app's page (up to 10), not the full price list. The value is never false.",
      "source": "App Store (US), top in-app purchases",
      "unit": "true / empty"
    },
    {
      "name": "review_sample_size",
      "type": "integer",
      "description": "Number of recent user reviews analyzed (App Store and Google Play combined).",
      "source": "App Store / Google Play user reviews",
      "unit": "reviews"
    },
    {
      "name": "review_period_start",
      "type": "date",
      "description": "Date of the oldest analyzed review.",
      "source": "App Store / Google Play user reviews",
      "unit": "YYYY-MM-DD"
    },
    {
      "name": "review_period_end",
      "type": "date",
      "description": "Date of the newest analyzed review.",
      "source": "App Store / Google Play user reviews",
      "unit": "YYYY-MM-DD"
    },
    {
      "name": "complaint_share_billing",
      "type": "number",
      "description": "Share of analyzed reviews that complain about unexpected charges or auto-renewal.",
      "source": "Recent App Store and Google Play user reviews, labeled by theme automatically",
      "unit": "share of analyzed reviews, 0–1"
    },
    {
      "name": "complaint_share_ads",
      "type": "number",
      "description": "Share of analyzed reviews that complain about too many ads.",
      "source": "Recent App Store and Google Play user reviews, labeled by theme automatically",
      "unit": "share of analyzed reviews, 0–1"
    },
    {
      "name": "complaint_share_paywall",
      "type": "number",
      "description": "Share of analyzed reviews that say the paywall comes too early or there are too few free episodes.",
      "source": "Recent App Store and Google Play user reviews, labeled by theme automatically",
      "unit": "share of analyzed reviews, 0–1"
    },
    {
      "name": "complaint_share_bugs",
      "type": "number",
      "description": "Share of analyzed reviews that report crashes, playback or login bugs.",
      "source": "Recent App Store and Google Play user reviews, labeled by theme automatically",
      "unit": "share of analyzed reviews, 0–1"
    },
    {
      "name": "praise_share_content",
      "type": "number",
      "description": "Share of analyzed reviews that praise the shows themselves.",
      "source": "Recent App Store and Google Play user reviews, labeled by theme automatically",
      "unit": "share of analyzed reviews, 0–1"
    },
    {
      "name": "data_based_score",
      "type": "number",
      "description": "Our overall score for the app, the same number shown on Vertical Drama Reviews. Computed by a published formula from store data and user reviews (see How we test).",
      "source": "Vertical Drama Reviews",
      "unit": "points, 0–10"
    },
    {
      "name": "score_rank",
      "type": "integer",
      "description": "Position in our ranking (1 = highest score).",
      "source": "Vertical Drama Reviews",
      "unit": "rank"
    },
    {
      "name": "checked_at",
      "type": "date",
      "description": "Latest date any value in this row was collected (store ratings, store listing, prices or review analysis).",
      "source": "Vertical Drama Reviews",
      "unit": "YYYY-MM-DD"
    }
  ],
